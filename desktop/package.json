{
  "name": "advmath-desktop",
  "version": "0.9.8",
  "description": "高数学习站 —— 离线桌面版（同济八版骨架 + 托马斯 14 版映射，中英对照）",
  "private": true,
  "main": "main.js",
  "author": "高等数学学习站",
  "license": "UNLICENSED",
  "scripts": {
    "electron:dev": "electron .",
    "electron:build": "electron-builder",
    "electron:build:sealed": "bash tools/build-all.sh"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.advmath.study",
    "productName": "高数学习站",
    "copyright": "高等数学学习站",
    "asar": true,
    "afterAllArtifactBuild": "tools/after-artifacts.js",
    "directories": {
      "buildResources": "build",
      "output": "../../../05_构建/高等数学学习站_桌面安装包"
    },
    "files": [
      "main.js",
      "preload.js",
      "player.html",
      "integrity.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "site",
        "filter": [
          "**/*",
          "!desktop/**",
          "!tools/**",
          "!tests/**",
          "!node_modules/**",
          "!桌面安装包/**",
          "!高等数学学习站_桌面安装包/**",
          "!.git/**",
          "!.git",
          "!.gitignore",
          "!.gitattributes",
          "!.backup/**",
          "!*.bak",
          "!**/*.bak",
          "!.DS_Store",
          "!**/.DS_Store",
          "!Thumbs.db",
          "!*.tmp",
          "!*.log",
          "!.archify/**",
          "!AGENTS.md"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "title": "高数学习站 ${version}",
      "format": "UDBZ"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "高数学习站",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName} ${version} 便携版.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "compression": "maximum"
  }
}
